import { Injectable, NestMiddleware } from '@nestjs/common';
import { IncomingMessage, ServerResponse } from 'http';

@Injectable()
export class AjaxRedirectMiddleware implements NestMiddleware {
    use(req: IncomingMessage, res: ServerResponse, next: () => void) {
        // Aquí req ya es IncomingMessage (req.raw en Fastify)
        const headers = req.headers;

        if (headers['x-requested-with'] === 'XMLHttpRequest' && req.url) {
            console.log('Redirigiendo petición AJAX a /ajax' + req.url);
            req.url = '/ajax' + req.url;
        }

        next();
    }
}
